// ClientDesk database schema.
// Postgres everywhere: locally, in CI, and in production (Neon on Vercel).
// DATABASE_URL is the pooled/runtime URL; DATABASE_URL_UNPOOLED is the
// direct URL Prisma migrations use. Locally and in CI both point at the
// same Postgres; on Vercel the Neon integration sets both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  businessName String?
  createdAt    DateTime  @default(now())
  email        String    @unique
  id           String    @id @default(cuid())
  passwordHash String
  clients      Client[]
  invoices     Invoice[]
  payments     Payment[]
  recurringTemplates RecurringTemplate[]
  sessions     Session[]
}

model Session {
  createdAt DateTime @default(now())
  expiresAt DateTime
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model Client {
  company   String?
  createdAt DateTime @default(now())
  email     String?
  id        String   @id @default(cuid())
  name      String
  notes     String?
  phone     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  invoices  Invoice[]
  recurringTemplates RecurringTemplate[]

  @@index([userId])
}

model Invoice {
  amount      Float
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  createdAt   DateTime @default(now())
  description String
  discountRate Float    @default(0)
  dueDate     String
  id          String   @id @default(cuid())
  issuedDate  String
  number      Int?
  payments    Payment[]
  status      String   @default("unpaid")
  taxRate     Float    @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@index([userId])
  @@index([clientId])
}

model RecurringTemplate {
  amount      Float
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  createdAt   DateTime @default(now())
  description String
  discountRate Float    @default(0)
  id          String   @id @default(cuid())
  nextDueDate String
  taxRate     Float    @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@index([userId])
  @@index([clientId])
}

model Payment {
  amount    Float
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  paidAt    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
  @@index([invoiceId])
}
