// ClientDesk database schema.
// Postgres everywhere: locally, in CI, and in production (Neon on Vercel).
// DATABASE_URL is the pooled/runtime URL; DATABASE_URL_UNPOOLED is the
// direct URL Prisma migrations use. Locally and in CI both point at the
// same Postgres; on Vercel the Neon integration sets both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  businessName String?
  createdAt    DateTime  @default(now())
  email        String    @unique
  githubId     String?   @unique
  googleId     String?   @unique
  id           String    @id @default(cuid())
  passwordHash String
  plan         String    @default("free")
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?
  clients      Client[]
  invoices     Invoice[]
  payments     Payment[]
  recurringTemplates RecurringTemplate[]
  resetTokens  PasswordResetToken[]
  sessions     Session[]
  auditEntries AuditLog[]
  webhookSubscriptions WebhookSubscription[]
}

/** One durable line per meaningful change a user makes, so an account
 * can answer "what changed, and when" without digging through rows.
 * Seeded demo data is deliberately not audited — it is not user work. */
model AuditLog {
  action    String
  createdAt DateTime @default(now())
  detail    String?
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model PasswordResetToken {
  createdAt DateTime @default(now())
  expiresAt DateTime
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Session {
  createdAt DateTime @default(now())
  expiresAt DateTime
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model Client {
  archived  Boolean  @default(false)
  company   String?
  createdAt DateTime @default(now())
  email     String?
  id        String   @id @default(cuid())
  name      String
  notes     String?
  phone     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  invoices  Invoice[]
  recurringTemplates RecurringTemplate[]

  @@index([userId])
}

model Invoice {
  amount      Float
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  createdAt   DateTime @default(now())
  description String
  discountRate Float    @default(0)
  dueDate     String
  id          String   @id @default(cuid())
  issuedDate  String
  number      Int?
  payments    Payment[]
  status      String   @default("unpaid")
  taxRate     Float    @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  items       InvoiceItem[]

  @@index([userId])
  @@index([clientId])
}

model InvoiceItem {
  description String
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  quantity    Float
  unitPrice   Float

  @@index([invoiceId])
}

model RecurringTemplate {
  amount      Float
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  createdAt   DateTime @default(now())
  description String
  discountRate Float    @default(0)
  id          String   @id @default(cuid())
  nextDueDate String
  taxRate     Float    @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@index([userId])
  @@index([clientId])
}

model Payment {
  amount    Float
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
  idempotencyKey String? @unique
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  method    String?
  paidAt    String
  reference String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
  @@index([invoiceId])
}

/** A user's own webhook URL, for Zapier and similar tools.
 * ClientDesk posts one JSON payload per event to the URL; the
 * secret signs each payload so the receiver can check it came
 * from ClientDesk. The secret is shown once, when created. */
model WebhookSubscription {
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  events    String[]
  id        String   @id @default(cuid())
  secret    String
  url       String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}
