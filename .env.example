# Copy to .env (never commit .env). Generate a real secret locally.
# Postgres everywhere: run Postgres locally (or use a hosted database),
# and point both URLs at it. On Vercel the Neon integration sets both.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clientdesk"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/clientdesk"
# Long random string, e.g. from: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"
