# Copy to .env (never commit .env or *.db). Generate a real secret locally.
# DATABASE_URL is SQLite locally: the file is created under prisma/ by
# `npx prisma migrate dev`. Production needs Postgres (see README) and
# `prisma migrate deploy` — not tested with this schema.
DATABASE_URL="file:./dev.db"
# Long random string, e.g. from: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"
